# Local dev only. This value is intentionally hardcoded and committed:
# it points at the local backend, contains no secrets, and lets anyone
# clone the repo and run `npm run dev` with zero setup.
# Staging and production values are injected at build time from CI
# secrets — see .env.staging.example / .env.production.example.
VITE_API_BASE_URL=http://localhost:8080